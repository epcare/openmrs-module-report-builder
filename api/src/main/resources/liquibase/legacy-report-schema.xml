<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="legacy-report-table-create" author="reportbuilder">
        <createTable tableName="legacy_report">
            <column name="uuid" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="version" type="VARCHAR(50)"/>
            <column name="category" type="VARCHAR(100)"/>
            <column name="subcategory" type="VARCHAR(100)"/>
            <column name="report_type" type="VARCHAR(50)"/>
            <column name="report_year" type="VARCHAR(50)"/>
            <column name="report_scope" type="VARCHAR(50)"/>
            <column name="status" type="VARCHAR(50)" defaultValue="ACTIVE"/>
            <column name="date_created" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="date_changed" type="TIMESTAMP"/>
            <column name="creator_user_id" type="INT"/>
            <column name="changed_user_id" type="INT"/>
            <column name="retired" type="TINYINT(1)" defaultValue="0"/>
            <column name="retire_reason" type="TEXT"/>
            <column name="config_json" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="legacy_report" indexName="idx_legacy_report_category">
            <column name="category"/>
        </createIndex>

        <createIndex tableName="legacy_report" indexName="idx_legacy_report_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="legacy_report" indexName="idx_legacy_report_name">
            <column name="name"/>
        </createIndex>

        <createIndex tableName="legacy_report" indexName="idx_legacy_report_retired">
            <column name="retired"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
